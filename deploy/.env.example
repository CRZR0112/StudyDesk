# Copy to .env and fill in.
# The domain must have an A/AAAA record pointing to this server.
DOMAIN=study.example.com

# Public HTTPS URL; must match DOMAIN (no trailing slash).
STUDYDESK_PUBLIC_URL=https://study.example.com

# Optional extra HTTP Basic Auth password. Leave empty to disable.
STUDYDESK_PIN=

# The app stores notes/uploads in the Docker volume `studydesk-data`.
# AI settings are configured in the web UI after first login.
# On Windows/Mac Docker, Ollama on the host is usually:
#   http://host.docker.internal:11434/v1
# On Linux, add host-gateway via docker-compose if needed, or use a cloud API.
